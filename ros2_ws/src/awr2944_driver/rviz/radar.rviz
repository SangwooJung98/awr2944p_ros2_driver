Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Radar point cloud1
      Splitter Ratio: 0.55
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 20; 24; 33
    Fixed Frame: radar_link
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Ground grid (1 m)
      Enabled: true
      Cell Size: 1
      Plane: XY
      Plane Cell Count: 20
      Color: 82; 90; 104
      Alpha: 0.5
    - Class: rviz_default_plugins/Axes
      Name: Radar axes
      Enabled: true
      Length: 1
      Radius: 0.03
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/PointCloud2
      Name: Radar point cloud
      Enabled: true
      Topic:
        Value: /radar/points
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Position Transformer: XYZ
      Color Transformer: Intensity
      Channel Name: velocity
      Autocompute Intensity Bounds: false
      Min Intensity: -2
      Max Intensity: 2
      Use rainbow: true
      Invert Rainbow: false
      Use Fixed Frame: true
      Style: Spheres
      Size (m): 0.08
      Size (Pixels): 4
      Alpha: 1
      Decay Time: 0
      Selectable: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Radar perspective
      Distance: 12
      Pitch: 0.65
      Yaw: 3.1
      Focal Point:
        X: 3
        Y: 0
        Z: 0
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
Window Geometry:
  Width: 1280
  Height: 800
